# ── API (api/) ──────────────────────────────────────────────────────────────
# Copy to api/.env for local dev. In Azure, set these on the Container App.

# Service name (shown in /health and logs).
APP_NAME=fi-template-api

# Public API gate. Unset → fail-open (dev). Set in production; the web build
# must send the same value as NEXT_PUBLIC_API_KEY.
APP_API_KEY=

# Feature flags — which optional capabilities this app ships (comma list,
# case-insensitive). The chat assistant is always on. Known: cms, marketplace.
# Unset → chat only. The web build must mirror this in NEXT_PUBLIC_APP_MODULES.
APP_MODULES=

# Seeds de arranque (un solo seeder, app/seeding.py). Path a un JSON con el
# catálogo canónico de la org; se re-aplica en cada boot para que los stores en
# memoria no sirvan una superficie vacía tras un restart. Idempotente por slug —
# un slug que ya está en el store se deja intacto, así un restart nunca resucita
# lo que alguien bajó. Por item: `publish: true` lo publica, `skip: true` lo deja
# en el archivo sin cargarlo nunca. Sin valor → no siembra.
CMS_SEED_FILE=
MARKETPLACE_SEED_FILE=

# Agent transport: AIRE's door, and only AIRE's door. The claude/codex switch
# (APP_BACKEND, APP_MODEL_CODEX, CLAUDE_CODE_OAUTH_TOKEN, AZURE_OPENAI_ENDPOINT)
# died with fi-runner's other backends on 2026-08-29 — none of them is read
# anymore. BOTH of these are REQUIRED or every turn raises "AIRE door not
# configured"; /health still answers, so watch the turn, not the probe.
AIRE_GATE_URL=
AIRE_AUTH_TOKEN=

# The AIRE casita this app addresses — its identity server-side. Its transcript,
# its living prompt and its corpus live under this name. [A-Za-z0-9_-], max 128.
APP_AIRE_PROJECT=python-bot

# Forwarded per turn; AIRE pins it on the session's client. A short name
# ("haiku", "sonnet") or a full model id both work.
APP_MODEL=claude-sonnet-4-5

# Door mode = the builtin surface, chosen server-side (a ToolPolicy in the code
# would NOT be honored — AIRE does not forward it):
#   agent    → Read/Write/Glob/Grep/WebSearch/WebFetch, caged to the casita
#   complete → no builtins at all
# Bash is prohibited in BOTH. Default: agent (the web access this template
# shipped with).
APP_AIRE_MODE=agent

# CORS — comma-separated origins. Unset → "*" (dev). Lock to the SWA URL in prod.
CORS_ALLOW_ORIGINS=

# Optional tuning (defaults shown).
# APP_CHAT_TURN_TIMEOUT_S=600
# APP_SSE_HEARTBEAT_S=15
# APP_REQUEST_TEXT_MAX_CHARS=12000

# Optional RAG: pass a corpus_id to /chat/stream and the turn asks AIRE for its
# `rag_store` tool. NOTE what changed on 2026-08-29 — the corpus now lives in
# AIRE's Postgres, not here. The FI_RAG_* vars below configured the LOCAL fi-core
# store that the in-process MCP server used to read; nothing in this app reads
# them anymore, and infra/docker-compose.dev.yml's pgvector is likewise only
# useful if you bring the local capability back.
# FI_RAG_BACKEND=hdf5
# FI_RAG_PGVECTOR_DSN=postgresql://app:app@127.0.0.1:5433/app
# FI_RAG_EMBED_DIM=256

# ── Web (web/) ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined at BUILD time. Set before `next build`.
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_API_KEY=
# Mirror of APP_MODULES for the front (same comma list). Disabled features'
# UIs are dynamically imported, so they never ship in the bundle.
# NEXT_PUBLIC_APP_MODULES=
